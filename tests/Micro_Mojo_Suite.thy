text \<open>Expected (Mojo 1.2.0 (2016d0cd)): ok\<close>

(* Mojo source:
def fib(n: Int) -> Int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def main():
    print(fib(10), fib(1), fib(0))
*)

definition t_a01_recursion :: prog where
  \<open>t_a01_recursion =
    Prog
      []
      [
        Fun
