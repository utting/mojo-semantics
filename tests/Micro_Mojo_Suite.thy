               SIf
                 (EBin binop.Lt (EPlace (PVar ''n'')) (EInt 2))
                 (SReturn (Some (EPlace (PVar ''n''))))
                 SPass,
               SReturn
                 (Some
                    (EBin
                       binop.Add
                       (ECall ''fib'' [EBin binop.Sub (EPlace (PVar ''n'')) (EInt 1)])
                       (ECall ''fib'' [EBin binop.Sub (EPlace (PVar ''n'')) (EInt 2)])))]),
        Fun
          ''main''
          []
          RNone
          (SPrint [ECall ''fib'' [EInt 10], ECall ''fib'' [EInt 1], ECall ''fib'' [EInt 0]])]\<close>

