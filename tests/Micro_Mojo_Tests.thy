subsection \<open>misc_control\<close>

text \<open>Expected (Mojo 1.2.0 (2016d0cd)): ok\<close>

(* Mojo source:
# micro-mojo-fuel: 10000
def fact(n: Int) -> Int:
    var acc = 1
    var i = 2
    while i <= n:
        acc *= i
        i += 1
    return acc

def classify(n: Int) -> Int:
    if n < 0:
        return -1
    elif n == 0:
        return 0
    else:
        return 1

def main():
    print(fact(5), classify(-4), classify(0), classify(9))
    var ok = 3 > 2 and not (1 >= 2)
    print(ok, 4 != 4, -7 - 1)
    var l = List[Int]()
    var i = 0
    while i < 4:
        l.append(i * i)
        i += 1
    print(l.pop(), len(l), l[2])
    print()
*)

definition t_misc_control :: prog where
  \<open>t_misc_control =
    Prog
      []
      [
        Fun
          ''fact''
          [(conv.Imm, ''n'', TInt)]
          (RVal TInt)
          (seq
             [
               SVar ''acc'' TInt (Some (EInt 1)),
               SVar ''i'' TInt (Some (EInt 2)),
               SWhile
                 (EBin binop.Le (EPlace (PVar ''i'')) (EPlace (PVar ''n'')))
                 (seq
                    [
                      SAssign
                        (PVar ''acc'')
                        (EBin binop.Mul (EPlace (PVar ''acc'')) (EPlace (PVar ''i''))),
                      SAssign (PVar ''i'') (EBin binop.Add (EPlace (PVar ''i'')) (EInt 1))]),
               SReturn (Some (EPlace (PVar ''acc'')))]),
        Fun
          ''classify''
          [(conv.Imm, ''n'', TInt)]
          (RVal TInt)
          (SIf
             (EBin binop.Lt (EPlace (PVar ''n'')) (EInt 0))
             (SReturn (Some (EInt (-1))))
             (SIf
                (EBin binop.Eq (EPlace (PVar ''n'')) (EInt 0))
                (SReturn (Some (EInt 0)))
                (SReturn (Some (EInt 1))))),
        Fun
          ''main''
          []
          RNone
          (seq
             [
               SPrint
                 [
                   ECall ''fact'' [EInt 5],
                   ECall ''classify'' [EInt (-4)],
                   ECall ''classify'' [EInt 0],
                   ECall ''classify'' [EInt 9]],
               SVar
                 ''ok''
                 TBool
                 (Some
                    (EBin
                       binop.And
                       (ENot (EBin binop.Le (EInt 3) (EInt 2)))
                       (ENot (ENot (EBin binop.Lt (EInt 1) (EInt 2)))))),
               SPrint
                 [
                   EPlace (PVar ''ok''),
                   ENot (EBin binop.Eq (EInt 4) (EInt 4)),
                   EBin binop.Sub (EInt (-7)) (EInt 1)],
               SVar ''l'' (TList TInt) (Some (EList [])),
               SVar ''i'' TInt (Some (EInt 0)),
               SWhile
                 (EBin binop.Lt (EPlace (PVar ''i'')) (EInt 4))
                 (seq
                    [
                      SExpr
                        (EMeth
                           (PVar ''l'')
                           ''append''
                           [EBin binop.Mul (EPlace (PVar ''i'')) (EPlace (PVar ''i''))]),
                      SAssign (PVar ''i'') (EBin binop.Add (EPlace (PVar ''i'')) (EInt 1))]),
               SPrint
                 [
                   EMeth (PVar ''l'') ''pop'' [],
                   ELen (PVar ''l''),
                   EPlace (PIndex (PVar ''l'') (EInt 2))],
               SPrint []])]\<close>

