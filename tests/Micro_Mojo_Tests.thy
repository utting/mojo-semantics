subsection \<open>ex1_conventions\<close>

text \<open>Expected (Mojo 1.2.0 (2016d0cd)): ok\<close>

(* Mojo source:
@fieldwise_init
struct Res:
    var id: Int
    def __deinit__(deinit self):
        print("drop", self.id)

def consume(var r: Res):
    print("got", r.id)

def bump(mut r: Res, n: Int):
    r.id += n

def pick(c: Bool, ref a: Res, ref b: Res) -> ref[a, b] Res:
    if c:
        return a
    else:
        return b

def main():
    var a = Res(1)
    var b = Res(2)
    bump(a, 10)
    ref r = pick(True, a, b)
    print(r.id)                  # 11
    consume(a^)                  # got 11 / drop 11
    var l: List[Int] = [1, 2, 3]
    ref e = l[0]
    print(e)                     # 1
    l.append(4)
*)

definition t_ex1_conventions :: prog where
  \<open>t_ex1_conventions =
    Prog
      [
        Struct
          ''Res''
          [(''id'', TInt)]
          False
          True
          None
          (Some (SPrint [EStr ''drop'', EPlace (PField (PVar ''self'') ''id'')]))
          []]
      [
        Fun
          ''consume''
          [(conv.Var, ''r'', TStruct ''Res'')]
          RNone
          (SPrint [EStr ''got'', EPlace (PField (PVar ''r'') ''id'')]),
        Fun
          ''bump''
          [(conv.Mut, ''r'', TStruct ''Res''), (conv.Imm, ''n'', TInt)]
          RNone
          (SAssign
             (PField (PVar ''r'') ''id'')
             (EBin binop.Add (EPlace (PField (PVar ''r'') ''id'')) (EPlace (PVar ''n'')))),
        Fun
          ''pick''
          [
            (conv.Imm, ''c'', TBool),
            (conv.Ref, ''a'', TStruct ''Res''),
            (conv.Ref, ''b'', TStruct ''Res'')]
          (RRef [''a'', ''b''] (TStruct ''Res''))
          (SIf
             (EPlace (PVar ''c''))
             (SReturn (Some (EPlace (PVar ''a''))))
             (SReturn (Some (EPlace (PVar ''b''))))),
        Fun
          ''main''
          []
          RNone
          (seq
             [
               SVar ''a'' (TStruct ''Res'') (Some (ECall ''Res'' [EInt 1])),
               SVar ''b'' (TStruct ''Res'') (Some (ECall ''Res'' [EInt 2])),
               SExpr (ECall ''bump'' [EPlace (PVar ''a''), EInt 10]),
               SRef ''r'' (ECall ''pick'' [EBool True, EPlace (PVar ''a''), EPlace (PVar ''b'')]),
               SPrint [EPlace (PField (PVar ''r'') ''id'')],
               SExpr (ECall ''consume'' [ETake (PVar ''a'')]),
               SVar ''l'' (TList TInt) (Some (EList [EInt 1, EInt 2, EInt 3])),
               SRef ''e'' (EPlace (PIndex (PVar ''l'') (EInt 0))),
               SPrint [EPlace (PVar ''e'')],
               SExpr (EMeth (PVar ''l'') ''append'' [EInt 4])])]\<close>

lemma t_ex1_conventions_test: \<open>test_output t_ex1_conventions 5000 [''11'', ''drop 2'', ''got 11'', ''drop 11'', ''1'']\<close>
  by eval

