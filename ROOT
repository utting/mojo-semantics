session Mojo_Semantics = HOL +
  sessions
    "HOL-Library"
  theories
    Mojo_Region_Model
    Micro_Mojo_Syntax
    Micro_Mojo_Semantics
    Micro_Mojo_Static
    Micro_Mojo_Soundness
    Micro_Mojo_Soundness_Stmt
    Micro_Mojo_Soundness_Calls
  document_files (in "paper/isadoc") "root.tex"

(* Differential tests against the Mojo compiler; Micro_Mojo_Tests.thy is
   generated by mojo2isabelle/mojo_suite.py. *)
session Mojo_Tests in tests = Mojo_Semantics +
  theories
    Micro_Mojo_Testing
    Micro_Mojo_Tests
    Micro_Mojo_Suite
    Micro_Mojo_Translation_Check

(* Fragments quoted in the paper, see paper/make-snippets.sh. *)
session Mojo_Paper in paper = Mojo_Semantics +
  options [document = pdf]
  theories
    Paper_Snippets
  document_files (in "isadoc") "root.tex"
